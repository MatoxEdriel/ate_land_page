---
import { Icon } from 'astro-icon/components';
import { siteConfig } from '../../data/siteConfig';

const navItems = [
  { label: 'Beneficios', href: siteConfig.links.benefits, icon: 'lucide:sparkles' },
  { label: 'Aty', href: siteConfig.links.pet, icon: 'lucide:bot' },
  { label: 'Contacto', href: siteConfig.links.contact, icon: 'lucide:mail' },
];
---

<header class="sticky top-3 sm:top-5 z-50 px-4 sm:px-6 w-full pointer-events-none">
  <div id="navbar-wrapper" class="max-w-3xl mx-auto pointer-events-auto">
    <div
      id="navbar-pill"
      class="bg-white/85 dark:bg-ate-surface/85 backdrop-blur-xl border border-ate-text/10 dark:border-white/10 rounded-full shadow-[0_8px_30px_rgb(0,0,0,0.06)] px-3 sm:px-4 py-2 flex items-center justify-between transition-all duration-300"
    >
      <a href="/" class="flex items-center gap-1.5 group pl-1">
        <div class="h-8 sm:h-9 flex items-center justify-center group-hover:scale-105 group-hover:-rotate-2 transition-transform duration-200">
          <img
            id="navbar-mascot-img"
            src="/assets/svg/mascot.svg"
            alt="A"
            class="h-7 sm:h-8 w-auto object-contain filter drop-shadow-sm"
          />
        </div>
        <span class="font-heading font-extrabold text-2xl tracking-tight text-ate-primary -ml-0.5">
          te
        </span>
      </a>

      <nav class="hidden md:flex items-center gap-1 sm:gap-1.5">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="px-3 py-1.5 rounded-full text-sm font-semibold text-ate-text/80 dark:text-ate-text hover:text-ate-primary dark:hover:text-ate-primary hover:bg-ate-primary/8 dark:hover:bg-white/5 transition-all duration-150"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <button
          id="theme-toggle"
          type="button"
          aria-label="Cambiar tema"
          class="flex items-center justify-center w-9 h-9 rounded-full bg-ate-canvas dark:bg-white/10 border border-ate-text/10 dark:border-white/15 text-ate-text dark:text-white hover:text-ate-primary dark:hover:text-ate-primary hover:bg-white dark:hover:bg-white/20 transition-all duration-200 cursor-pointer"
        >
          <Icon id="theme-icon-sun" name="lucide:sun" class="w-4 h-4 hidden dark:block" />
          <Icon id="theme-icon-moon" name="lucide:moon" class="w-4 h-4 block dark:hidden" />
        </button>

        <a
          href={siteConfig.appUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-2 px-4 sm:px-5 py-2 rounded-full font-bold text-xs sm:text-sm bg-ate-primary text-white hover:bg-ate-primary/90 shadow-sm hover:shadow-md hover:scale-[1.02] active:scale-95 transition-all duration-200 group"
        >
          <span>Ingresar a la App</span>
          <Icon name="lucide:arrow-right" class="w-4 h-4 transition-transform group-hover:translate-x-0.5" />
        </a>

        <button
          id="mobile-menu-toggle"
          type="button"
          aria-label="Abrir menú"
          aria-expanded="false"
          class="md:hidden flex items-center justify-center w-9 h-9 rounded-full bg-ate-canvas dark:bg-white/10 border border-ate-text/10 dark:border-white/15 text-ate-text dark:text-white hover:text-ate-primary hover:bg-white dark:hover:bg-white/20 transition-colors cursor-pointer"
        >
          <Icon id="menu-icon-open" name="lucide:menu" class="w-5 h-5" />
          <Icon id="menu-icon-close" name="lucide:x" class="w-5 h-5 hidden" />
        </button>
      </div>
    </div>

    <div
      id="mobile-menu"
      class="hidden md:hidden mt-2 p-4 bg-white/95 dark:bg-ate-surface/95 backdrop-blur-2xl border border-ate-text/10 dark:border-white/10 rounded-3xl shadow-2xl transition-all duration-300"
    >
      <div class="flex flex-col gap-1.5">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="mobile-nav-link flex items-center gap-3 px-4 py-3 rounded-2xl text-sm font-semibold text-ate-text hover:text-ate-primary hover:bg-ate-primary/10 dark:hover:bg-white/5 transition-colors"
          >
            <div class="w-8 h-8 rounded-xl bg-ate-canvas dark:bg-white/5 flex items-center justify-center text-ate-primary">
              <Icon name={item.icon} class="w-4 h-4" />
            </div>
            <span>{item.label}</span>
          </a>
        ))}
      </div>

      <div class="mt-4 pt-3 border-t border-ate-text/10 dark:border-white/10">
        <a
          href={siteConfig.appUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-nav-link flex items-center justify-center gap-2 w-full py-3 px-4 rounded-2xl font-bold text-sm bg-ate-primary text-white hover:bg-ate-primary/90 shadow-sm transition-all"
        >
          <span>Ingresar a la App</span>
          <Icon name="lucide:arrow-right" class="w-4 h-4" />
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  function setupNavbar() {
    const navbarPill = document.getElementById('navbar-pill');
    const menuToggle = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');
    const navLinks = document.querySelectorAll('.mobile-nav-link');
    const wrapper = document.getElementById('navbar-wrapper');
    const themeToggle = document.getElementById('theme-toggle');

    if (!navbarPill || !menuToggle || !mobileMenu || !iconOpen || !iconClose) {
      return;
    }

    const mascotImage = document.getElementById('navbar-mascot-img') as HTMLImageElement | null;
    if (
      mascotImage &&
      (window.location.search.toLowerCase().includes('uwu') ||
        window.location.pathname.toLowerCase().includes('uwu'))
    ) {
      mascotImage.src = '/assets/svg/aty-uwu.svg';
    }

    if (themeToggle) {
      themeToggle.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    }

    function toggleMenu(forceState) {
      const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
      const shouldOpen = typeof forceState === 'boolean' ? forceState : !isExpanded;

      menuToggle.setAttribute('aria-expanded', String(shouldOpen));

      if (shouldOpen) {
        mobileMenu.classList.remove('hidden');
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
      } else {
        mobileMenu.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      }
    }

    menuToggle.addEventListener('click', () => toggleMenu());

    navLinks.forEach((link) => {
      link.addEventListener('click', () => toggleMenu(false));
    });

    document.addEventListener('click', (event) => {
      if (wrapper && !wrapper.contains(event.target) && !mobileMenu.classList.contains('hidden')) {
        toggleMenu(false);
      }
    });

    function handleScroll() {
      if (window.scrollY > 20) {
        navbarPill.classList.add('shadow-lg', 'bg-white/95', 'dark:bg-ate-surface/95', 'border-ate-text/15');
        navbarPill.classList.remove('bg-white/85', 'dark:bg-ate-surface/85');
      } else {
        navbarPill.classList.remove('shadow-lg', 'bg-white/95', 'dark:bg-ate-surface/95', 'border-ate-text/15');
        navbarPill.classList.add('bg-white/85', 'dark:bg-ate-surface/85');
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }

  setupNavbar();
  document.addEventListener('astro:after-swap', setupNavbar);
</script>
