---
import { siteConfig } from '../../data/siteConfig';
import Button from '../common/Button.astro';
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-ate-canvas/90 border-b border-ate-text/10 transition-all">
  <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-10 h-10 rounded-xl bg-ate-primary text-white flex items-center justify-center font-bold text-xl shadow-ate-sm group-hover:scale-105 transition-transform">
        a
      </div>
      <span class="font-heading font-extrabold text-2xl tracking-tight text-ate-primary">ate</span>
    </a>

    <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-ate-text/80">
      <a href={siteConfig.links.benefits} class="hover:text-ate-primary transition-colors">Beneficios</a>
      <a href={siteConfig.links.solutions} class="hover:text-ate-primary transition-colors">Soluciones</a>
      <a href={siteConfig.links.pet} class="hover:text-ate-primary transition-colors">Aty & Estadística</a>
      <a href={siteConfig.links.contact} class="hover:text-ate-primary transition-colors">Contacto</a>
    </nav>

    <div class="flex items-center gap-4">
      <Button href={siteConfig.appUrl} target="_blank" variant="primary">
        Ingresar a la App
      </Button>
    </div>
  </div>
</header>
