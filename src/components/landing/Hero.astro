---
import { siteConfig } from '../../data/siteConfig';
import { statsData } from '../../data/stats';
import Button from '../common/Button.astro';
import LiveSimulator from './LiveSimulator.astro';
---

<section class="relative overflow-hidden pt-16 pb-24 md:pt-24 md:pb-32">
  <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
    <div class="lg:col-span-7 space-y-6">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-ate-primary/10 border border-ate-primary/20 text-ate-primary font-semibold text-xs tracking-wide uppercase">
        <span class="w-2 h-2 rounded-full bg-ate-primary animate-pulse"></span>
        Plataforma Inteligente de Saldos y Beneficios
      </div>

      <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl font-extrabold text-ate-text leading-tight tracking-tight">
        Gestión inteligente de <span class="text-ate-primary underline decoration-ate-secondary/50 underline-offset-8">saldos</span> y beneficios corporativos
      </h1>

      <p class="text-lg md:text-xl text-ate-muted max-w-2xl font-normal leading-relaxed">
        {siteConfig.description}
      </p>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-4">
        <Button href={siteConfig.appUrl} target="_blank" variant="primary">
          Comenzar Ahora
        </Button>
        <Button href={siteConfig.links.benefits} variant="outline">
          Explorar Soluciones
        </Button>
      </div>

      <div class="pt-8 border-t border-ate-text/10 grid grid-cols-3 gap-6">
        {statsData.map((stat) => (
          <div>
            <div class={`font-heading font-extrabold text-2xl ${stat.colorClass}`}>{stat.value}</div>
            <div class="text-xs text-ate-muted font-medium">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="lg:col-span-5 w-full">
      <LiveSimulator />
    </div>
  </div>
</section>
