---
import { siteConfig } from '../../data/siteConfig';
import Button from '../common/Button.astro';
---

<section id="contacto" class="relative overflow-hidden py-20 bg-ate-primary dark:bg-gradient-to-b dark:from-ate-primary/30 dark:to-ate-surface border-t border-transparent dark:border-white/5 text-white">
  <div class="cta-gauss absolute inset-0 pointer-events-none" aria-hidden="true">
    <svg class="w-full h-full" viewBox="0 0 1200 400" preserveAspectRatio="none">
      <defs>
        <linearGradient id="ctaGaussFill" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#6ee7b7" stop-opacity="0.18"></stop>
          <stop offset="100%" stop-color="#6ee7b7" stop-opacity="0"></stop>
        </linearGradient>
      </defs>
      <path class="cta-gauss-fill" fill="url(#ctaGaussFill)"></path>
      <path class="cta-gauss-line" fill="none" stroke="rgba(110,231,183,0.35)" stroke-width="1.5" vector-effect="non-scaling-stroke"></path>
      <path class="cta-gauss-line-soft" fill="none" stroke="rgba(167,243,208,0.15)" stroke-width="1" vector-effect="non-scaling-stroke"></path>
    </svg>
  </div>

  <div class="relative max-w-5xl mx-auto px-6 text-center space-y-8">
    <h2 class="font-heading text-3xl sm:text-5xl font-extrabold text-white">
      ¿Listo para llevar los beneficios de tu empresa al siguiente nivel?
    </h2>
    <p class="text-white/80 text-lg max-w-2xl mx-auto">
      Únete a las empresas inteligentes que confían en Ate para administrar sus saldos y vales corporativos.
    </p>
    <div class="pt-4">
      <Button href={siteConfig.appUrl} target="_blank" variant="white">
        Acceder a la Aplicación
      </Button>
    </div>
  </div>
</section>

<script>
  function setupCtaGauss() {
    const layer = document.querySelector<HTMLElement>('.cta-gauss');
    if (!layer || layer.dataset.ready === '1') return;
    layer.dataset.ready = '1';

    const section = layer.closest('#contacto');
    const line = layer.querySelector('.cta-gauss-line');
    const lineSoft = layer.querySelector('.cta-gauss-line-soft');
    const fill = layer.querySelector('.cta-gauss-fill');
    if (!section || !line || !lineSoft || !fill) return;

    const W = 1200;
    const H = 400;
    const BASE = 430;
    const AMP = 345;
    const SIGMA = 155;
    const PERIOD = W;
    const STEP = 10;
    const DURATION = 22000;
    const EDGE = 80;

    function bellPoints(mu: number, amp: number, sigma: number) {
      const pts: string[] = [];
      let first = true;
      for (let x = -EDGE; x <= W + EDGE; x += STEP) {
        let peak = 0;
        for (let k = -1; k <= 1; k++) {
          const dx = (x - (mu + k * PERIOD)) / sigma;
          const v = Math.exp(-0.5 * dx * dx);
          if (v > peak) peak = v;
        }
        const px = (first ? 'M' : 'L') + x.toFixed(1) + ' ' + (BASE - peak * amp).toFixed(1);
        pts.push(px);
        first = false;
      }
      return pts.join('');
    }

    function closedPath(d: string) {
      return `${d}L${W + EDGE} ${H}L${-EDGE} ${H}Z`;
    }

    function render(mu: number) {
      const main = bellPoints(mu, AMP, SIGMA);
      line.setAttribute('d', main);
      fill.setAttribute('d', closedPath(main));
      lineSoft.setAttribute('d', bellPoints(mu + PERIOD / 2, AMP * 0.5, SIGMA * 0.75));
    }

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) {
      render(PERIOD * 0.35);
      return;
    }

    let raf: number | null = null;
    let start: number | null = null;

    function frame(ts: number) {
      if (start === null) start = ts;
      const t = ((ts - start) % DURATION) / DURATION;
      render(t * PERIOD);
      raf = requestAnimationFrame(frame);
    }

    function stop() {
      if (raf !== null) cancelAnimationFrame(raf);
      raf = null;
      start = null;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            if (raf === null) raf = requestAnimationFrame(frame);
          } else {
            stop();
          }
        }
      },
      { threshold: 0.05 }
    );
    observer.observe(section);

    render(0);
  }

  setupCtaGauss();
  document.addEventListener('astro:after-swap', setupCtaGauss);
</script>
