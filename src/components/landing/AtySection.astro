---
import { Icon } from 'astro-icon/components';
import { atyInfo } from '../../data/atyInfo';

const borderColors = {
  primary: 'hover:border-ate-primary/40 hover:shadow-lg hover:shadow-ate-primary/10',
  secondary: 'hover:border-ate-secondary/40 hover:shadow-lg hover:shadow-ate-secondary/15',
  alert: 'hover:border-ate-alert/40 hover:shadow-lg hover:shadow-ate-alert/10',
};

const watermarkColors = {
  primary: 'text-ate-primary/10',
  secondary: 'text-ate-secondary/15',
  alert: 'text-ate-alert/10',
};

const leftFeatures = [
  {
    title: 'Predicción de Demanda',
    description: 'Anticipa picos diarios de comensales para que los restaurantes preparen raciones exactas.',
    icon: 'lucide:trending-up',
    badgeColor: 'primary' as const,
  },
  {
    title: 'Cocina Cero Mermas',
    description: 'Reduce hasta un 35% el desperdicio de insumos sincronizando inventario con menús reservados.',
    icon: 'lucide:utensils',
    badgeColor: 'secondary' as const,
  },
];

const rightFeatures = [
  {
    title: 'Distribución Sin Sesgos',
    description: 'Asignación presupuestaria equilibrada basada en patrones de consumo y la curva normal.',
    icon: 'lucide:scale',
    badgeColor: 'primary' as const,
  },
  {
    title: 'Trazabilidad Total',
    description: 'Decisiones inteligentes con analítica en vivo y sin conciliaciones manuales a fin de mes.',
    icon: 'lucide:activity',
    badgeColor: 'alert' as const,
  },
];
---

<section id="mascota" class="py-24 sm:py-32 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20 space-y-4">
      <h2 class="font-heading text-3xl sm:text-5xl font-extrabold text-ate-text tracking-tight">
        {atyInfo.title}
      </h2>

      <p class="text-base sm:text-lg text-ate-muted leading-relaxed max-w-2xl mx-auto">
        {atyInfo.description}
      </p>
    </div>

    <div id="aty-showcase" class="relative max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-6 items-center">
        <div class="lg:col-span-4 flex flex-col gap-6 order-2 lg:order-1">
          {leftFeatures.map((item, index) => (
            <div
              class={`aty-card aty-card-left relative overflow-hidden p-7 sm:p-8 rounded-3xl bg-white dark:bg-ate-surface border border-ate-text/10 dark:border-white/10 shadow-ate-card ${borderColors[item.badgeColor]} transition-all duration-300 flex flex-col justify-center min-h-[160px] group`}
              style={`transition-delay: ${index * 130}ms;`}
            >
              <div
                class={`absolute -right-4 -bottom-4 w-32 h-32 sm:w-36 sm:h-36 pointer-events-none transition-transform duration-500 ease-out group-hover:scale-110 group-hover:-rotate-6 ${watermarkColors[item.badgeColor]}`}
              >
                <Icon name={item.icon} class="w-full h-full stroke-[1.2]" />
              </div>

              <div class="relative z-10 flex flex-col justify-center">
                <h3 class="font-heading font-extrabold text-xl text-ate-text mb-2.5 group-hover:text-ate-primary transition-colors tracking-tight">
                  {item.title}
                </h3>
                <p class="text-sm text-ate-muted leading-relaxed max-w-[88%]">
                  {item.description}
                </p>
              </div>
            </div>
          ))}
        </div>

        <div class="lg:col-span-4 flex flex-col items-center justify-center order-1 lg:order-2 py-6 relative">
          <div class="aty-centerpiece flex flex-col items-center justify-center w-full">
            <div class="relative flex items-center justify-center w-full">
              <div class="absolute w-64 h-64 bg-ate-primary/10 dark:hidden rounded-full blur-3xl -z-10 pointer-events-none"></div>

              <img
                src="/mascot.svg"
                alt="Aty - Mascota Oficial de Ate"
                class="aty-mascot-img w-72 sm:w-80 lg:w-[360px] h-auto object-contain filter drop-shadow-xl transition-transform duration-500 hover:scale-105"
              />
            </div>
          </div>
        </div>

        <div class="lg:col-span-4 flex flex-col gap-6 order-3">
          {rightFeatures.map((item, index) => (
            <div
              class={`aty-card aty-card-right relative overflow-hidden p-7 sm:p-8 rounded-3xl bg-white dark:bg-ate-surface border border-ate-text/10 dark:border-white/10 shadow-ate-card ${borderColors[item.badgeColor]} transition-all duration-300 flex flex-col justify-center min-h-[160px] group`}
              style={`transition-delay: ${(index + 2) * 130}ms;`}
            >
              <div
                class={`absolute -right-4 -bottom-4 w-32 h-32 sm:w-36 sm:h-36 pointer-events-none transition-transform duration-500 ease-out group-hover:scale-110 group-hover:-rotate-6 ${watermarkColors[item.badgeColor]}`}
              >
                <Icon name={item.icon} class="w-full h-full stroke-[1.2]" />
              </div>

              <div class="relative z-10 flex flex-col justify-center">
                <h3 class="font-heading font-extrabold text-xl text-ate-text mb-2.5 group-hover:text-ate-primary transition-colors tracking-tight">
                  {item.title}
                </h3>
                <p class="text-sm text-ate-muted leading-relaxed max-w-[88%]">
                  {item.description}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes atyIdleFloat {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  .aty-mascot-img {
    animation: atyIdleFloat 4.2s ease-in-out infinite;
  }

  .aty-card-left {
    opacity: 0;
    transform: translateX(-32px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .aty-card-right {
    opacity: 0;
    transform: translateX(32px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .aty-centerpiece {
    opacity: 0;
    transform: scale(0.92);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #aty-showcase.is-visible .aty-card-left,
  #aty-showcase.is-visible .aty-card-right {
    opacity: 1;
    transform: translate(0, 0);
  }

  #aty-showcase.is-visible .aty-card-left:hover,
  #aty-showcase.is-visible .aty-card-right:hover {
    transform: translateY(-6px);
  }

  #aty-showcase.is-visible .aty-centerpiece {
    opacity: 1;
    transform: scale(1);
  }

  @media (max-width: 1023px) {
    .aty-card-left,
    .aty-card-right {
      transform: translateY(24px) !important;
    }

    #aty-showcase.is-visible .aty-card-left,
    #aty-showcase.is-visible .aty-card-right {
      transform: translateY(0) !important;
    }

    #aty-showcase.is-visible .aty-card-left:hover,
    #aty-showcase.is-visible .aty-card-right:hover {
      transform: translateY(-6px) !important;
    }
  }
</style>

<script>
  function setupAtyScrollObserver() {
    const showcaseElement = document.getElementById('aty-showcase');
    if (!showcaseElement) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            showcaseElement.classList.add('is-visible');
            observer.unobserve(showcaseElement);
          }
        });
      },
      {
        threshold: 0.15,
        rootMargin: '0px 0px -40px 0px',
      }
    );

    observer.observe(showcaseElement);
  }

  setupAtyScrollObserver();
  document.addEventListener('astro:after-swap', setupAtyScrollObserver);
</script>
