---
import { Icon } from 'astro-icon/components';
import { atyInfo } from '../../data/atyInfo';
---

<section id="mascota" class="py-20">
  <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
    <div class="bg-ate-primary/5 p-8 sm:p-12 rounded-3xl border border-ate-primary/10 flex flex-col items-center justify-center relative overflow-hidden">
      <div class="absolute -top-12 -right-12 w-48 h-48 bg-ate-primary/10 rounded-full blur-2xl"></div>
      <div class="relative z-10 text-center space-y-4">
        <img
          src="/mascot.svg"
          alt="Aty Mascot"
          class="w-48 h-48 sm:w-64 sm:h-64 object-contain mx-auto drop-shadow-md hover:scale-105 transition-transform duration-300"
        />
        <div class="inline-block px-4 py-1.5 rounded-full bg-ate-primary/10 text-xs font-bold text-ate-primary tracking-widest uppercase">
          {atyInfo.subtitle}
        </div>
      </div>
    </div>

    <div class="space-y-6">
      <h2 class="font-heading text-3xl sm:text-4xl font-bold text-ate-text">
        {atyInfo.title}
      </h2>
      <p class="text-ate-muted leading-relaxed">
        {atyInfo.description}
      </p>
      <ul class="space-y-3 text-sm text-ate-text">
        {atyInfo.bulletPoints.map((point) => (
          <li class="flex items-center gap-3">
            <Icon name="lucide:check-circle-2" class="w-5 h-5 text-ate-primary flex-shrink-0" />
            {point}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
