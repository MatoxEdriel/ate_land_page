---
import { Icon } from 'astro-icon/components';
import { siteConfig } from '../../data/siteConfig';
---

<footer class="bg-ate-footer text-white/90 py-12 sm:py-14 border-t border-white/10 dark:border-white/5">
  <div class="max-w-5xl mx-auto px-6 space-y-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6 pb-6 border-b border-white/10 dark:border-white/5">
      <a href="/" class="flex items-center gap-1.5 group">
        <div class="h-8 flex items-center justify-center group-hover:scale-105 transition-transform duration-200">
          <img src="/assets/svg/mascot.svg" alt="A" class="h-7 w-auto object-contain filter drop-shadow-sm" />
        </div>
        <span class="font-heading font-extrabold text-2xl tracking-tight text-white -ml-0.5">te</span>
      </a>

      <nav class="flex flex-wrap items-center justify-center gap-6 sm:gap-8 text-sm text-white/70">
        <a href={siteConfig.links.benefits} class="hover:text-white transition-colors">Beneficios</a>
        <a href={siteConfig.links.solutions} class="hover:text-white transition-colors">Soluciones</a>
        <a href={siteConfig.links.pet} class="hover:text-white transition-colors">Aty</a>
        <a
          href={`mailto:${siteConfig.supportEmail}`}
          class="flex items-center gap-1.5 text-ate-secondary hover:text-ate-secondary/80 font-medium transition-colors"
        >
          <Icon name="lucide:mail" class="w-4 h-4" />
          <span>{siteConfig.supportEmail}</span>
        </a>
      </nav>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-white/50 text-center sm:text-left">
      <p>&copy; {new Date().getFullYear()} {siteConfig.name} Inc. Todos los derechos reservados.</p>
      <p class="text-white/40">Plataforma inteligente de vales corporativos y beneficios.</p>
    </div>
  </div>
</footer>
