---
import { Icon } from 'astro-icon/components';
import { featuresData } from '../../data/features';

const borderColors = {
  primary: 'hover:border-ate-primary/40 hover:shadow-lg hover:shadow-ate-primary/10',
  secondary: 'hover:border-ate-secondary/40 hover:shadow-lg hover:shadow-ate-secondary/15',
  alert: 'hover:border-ate-alert/40 hover:shadow-lg hover:shadow-ate-alert/10',
};

const watermarkColors = {
  primary: 'text-ate-primary/10',
  secondary: 'text-ate-secondary/15',
  alert: 'text-ate-alert/10',
};
---

<section id="beneficios" class="py-20 bg-ate-canvas border-y border-ate-text/5 dark:border-white/5">
  <div class="max-w-7xl mx-auto px-6 space-y-12">
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <h2 class="font-heading text-3xl sm:text-4xl font-bold text-ate-text">
        Diseñado para optimizar los beneficios de tu empresa
      </h2>
      <p class="text-ate-muted text-base">
        Una suite completa de herramientas para administrar vales de consumo, salud y tarjetas con trazabilidad total.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {featuresData.map((feature) => (
        <div
          class={`relative overflow-hidden p-7 sm:p-8 rounded-3xl bg-white dark:bg-ate-surface border border-ate-text/10 dark:border-white/10 shadow-ate-card ${borderColors[feature.badgeColor]} transition-all duration-300 hover:-translate-y-1.5 flex flex-col justify-center min-h-[170px] group`}
        >
          <div
            class={`absolute -right-5 -bottom-5 w-36 h-36 sm:w-40 sm:h-40 pointer-events-none transition-transform duration-500 ease-out group-hover:scale-110 group-hover:-rotate-6 ${watermarkColors[feature.badgeColor]}`}
          >
            <Icon name={feature.icon} class="w-full h-full stroke-[1.2]" />
          </div>

          <div class="relative z-10 flex flex-col justify-center">
            <h3 class="font-heading font-extrabold text-xl text-ate-text mb-2.5 group-hover:text-ate-primary transition-colors tracking-tight">
              {feature.title}
            </h3>
            <p class="text-sm text-ate-muted leading-relaxed max-w-[88%]">
              {feature.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
