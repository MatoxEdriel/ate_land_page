---
import { Icon } from 'astro-icon/components';
import Card from '../common/Card.astro';

interface Transaction {
  id: string;
  name: string;
  category: string;
  amount: string;
  icon: string;
  iconBg: string;
}

const initialTransactions: Transaction[] = [
  {
    id: 'tx-1',
    name: 'Almuerzo Executive',
    category: 'Vale Alimentación',
    amount: '$3.50',
    icon: 'lucide:utensils',
    iconBg: 'bg-ate-primary text-white',
  },
  {
    id: 'tx-2',
    name: 'Pase de Gimnasio',
    category: 'Crédito Bienestar',
    amount: '$15.00',
    icon: 'lucide:dumbbell',
    iconBg: 'bg-ate-secondary text-white',
  },
  {
    id: 'tx-3',
    name: 'Bono Farmacia',
    category: 'Crédito de Salud',
    amount: '$25.00',
    icon: 'lucide:heart-pulse',
    iconBg: 'bg-ate-alert text-white',
  },
];
---

<div class="relative w-full max-w-md mx-auto">
  <div class="absolute -top-10 -right-10 w-72 h-72 bg-ate-secondary/20 rounded-full blur-3xl -z-10"></div>
  <div class="absolute -bottom-10 -left-10 w-72 h-72 bg-ate-primary/20 rounded-full blur-3xl -z-10"></div>

  <div id="incoming-toast-container" class="mb-4 h-16 relative overflow-hidden">
    <div
      id="incoming-toast"
      class="w-full bg-ate-surface border-2 border-ate-primary/30 rounded-xl p-3 shadow-lg flex items-center justify-between transition-all duration-500 transform translate-y-0 opacity-100"
    >
      <div class="flex items-center gap-3">
        <div id="toast-icon-bg" class="w-8 h-8 rounded-lg bg-ate-primary text-white flex items-center justify-center font-bold text-xs">
          <Icon id="toast-icon" name="lucide:utensils" class="w-4 h-4" />
        </div>
        <div>
          <div id="toast-title" class="font-bold text-xs text-ate-text">Almuerzo Executive</div>
          <div id="toast-status" class="text-[10px] text-ate-primary font-semibold flex items-center gap-1">
            <Icon name="lucide:check-circle-2" class="w-3 h-3 text-ate-primary animate-spin" />
            <span>Procesando saldo corporativo...</span>
          </div>
        </div>
      </div>
      <div id="toast-amount" class="font-heading font-extrabold text-sm text-ate-primary">+$3.50</div>
    </div>
  </div>

  <Card class="space-y-6 relative z-10 border-2 border-ate-text/10 shadow-2xl">
    <div class="flex items-center justify-between pb-4 border-b border-ate-text/5">
      <div>
        <span class="text-xs text-ate-muted uppercase font-semibold tracking-wider">Simulación en Vivo</span>
        <h3 class="font-heading font-bold text-xl text-ate-text">Billetera de Beneficios</h3>
      </div>
      <div class="flex items-center gap-1.5 px-3 py-1 bg-ate-primary/10 text-ate-primary font-bold text-xs rounded-full">
        <span class="w-2 h-2 rounded-full bg-ate-primary animate-ping"></span>
        <span>Tiempo Real</span>
      </div>
    </div>

    <div class="space-y-1">
      <div class="text-xs text-ate-muted font-medium">Saldo Disponible Estimado</div>
      <div id="live-total-balance" class="text-4xl font-heading font-black text-ate-primary tracking-tight transition-all duration-300">
        $1,450.00
      </div>
    </div>

    <div class="space-y-3 pt-2">
      <div class="text-xs font-bold text-ate-muted uppercase tracking-wider">Últimos Movimientos Aprobados</div>

      <div id="transactions-list" class="space-y-2.5 max-h-60 overflow-hidden">
        {
          initialTransactions.map((tx) => (
            <div class="tx-row p-3 rounded-xl bg-ate-canvas flex items-center justify-between border border-ate-text/5 transition-all duration-300">
              <div class="flex items-center gap-3">
                <div class={`w-9 h-9 rounded-lg ${tx.iconBg} flex items-center justify-center font-bold text-sm shadow-sm`}>
                  <Icon name={tx.icon} class="w-5 h-5" />
                </div>
                <div>
                  <div class="font-semibold text-sm text-ate-text">{tx.name}</div>
                  <div class="text-xs text-ate-muted">{tx.category}</div>
                </div>
              </div>
              <div class="font-heading font-bold text-sm text-ate-primary">{tx.amount}</div>
            </div>
          ))
        }
      </div>
    </div>
  </Card>
</div>

<script>
  const incomingQueue = [
    { name: 'Almuerzo Executive', category: 'Vale Alimentación', amount: '$3.50', rawAmount: 3.5, icon: 'lucide:utensils', bgClass: 'bg-ate-primary' },
    { name: 'Pase de Gimnasio', category: 'Crédito Bienestar', amount: '$15.00', rawAmount: 15.0, icon: 'lucide:dumbbell', bgClass: 'bg-ate-secondary' },
    { name: 'Bono Farmacia', category: 'Crédito de Salud', amount: '$25.00', rawAmount: 25.0, icon: 'lucide:heart-pulse', bgClass: 'bg-ate-alert' },
    { name: 'Café & Snack', category: 'Vale Alimentación', amount: '$4.20', rawAmount: 4.2, icon: 'lucide:coffee', bgClass: 'bg-ate-primary' },
  ];

  let currentBalance = 1450.00;
  let queueIndex = 0;

  const toastElement = document.getElementById('incoming-toast');
  const toastTitle = document.getElementById('toast-title');
  const toastAmount = document.getElementById('toast-amount');
  const toastStatus = document.getElementById('toast-status');
  const toastIconBg = document.getElementById('toast-icon-bg');
  const balanceElement = document.getElementById('live-total-balance');
  const listContainer = document.getElementById('transactions-list');

  function triggerNextSimulation() {
    if (!toastElement || !listContainer || !balanceElement) return;

    const item = incomingQueue[queueIndex];
    queueIndex = (queueIndex + 1) % incomingQueue.length;

    if (toastTitle) toastTitle.textContent = item.name;
    if (toastAmount) toastAmount.textContent = `+${item.amount}`;
    if (toastStatus) {
      toastStatus.innerHTML = `<span class="inline-block w-2 h-2 rounded-full bg-ate-primary animate-ping"></span> Aprobado y Asignado ✓`;
    }
    if (toastIconBg) {
      toastIconBg.className = `w-8 h-8 rounded-lg ${item.bgClass} text-white flex items-center justify-center font-bold text-xs`;
    }

    toastElement.classList.remove('opacity-0', '-translate-y-4');
    toastElement.classList.add('opacity-100', 'translate-y-0', 'scale-105');

    setTimeout(() => {
      currentBalance += item.rawAmount;
      balanceElement.textContent = `$${currentBalance.toFixed(2)}`;
      balanceElement.classList.add('scale-110', 'text-ate-secondary');

      setTimeout(() => {
        balanceElement.classList.remove('scale-110', 'text-ate-secondary');
      }, 300);

      const newRow = document.createElement('div');
      newRow.className = 'tx-row p-3 rounded-xl bg-ate-canvas flex items-center justify-between border border-ate-text/5 transition-all duration-500 opacity-0 -translate-y-2';
      newRow.innerHTML = `
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-lg ${item.bgClass} text-white flex items-center justify-center font-bold text-sm shadow-sm">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
          </div>
          <div>
            <div class="font-semibold text-sm text-ate-text">${item.name}</div>
            <div class="text-xs text-ate-muted">${item.category}</div>
          </div>
        </div>
        <div class="font-heading font-bold text-sm text-ate-primary">+${item.amount}</div>
      `;

      if (listContainer.firstChild) {
        listContainer.insertBefore(newRow, listContainer.firstChild);
      } else {
        listContainer.appendChild(newRow);
      }

      requestAnimationFrame(() => {
        newRow.classList.remove('opacity-0', '-translate-y-2');
        newRow.classList.add('opacity-100', 'translate-y-0');
      });

      if (listContainer.children.length > 4) {
        listContainer.removeChild(listContainer.lastChild!);
      }

      toastElement.classList.remove('scale-105');
    }, 1200);
  }

  setInterval(triggerNextSimulation, 3500);
</script>
