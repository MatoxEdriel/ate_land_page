---
import { Icon } from 'astro-icon/components';
---

<div class="relative w-full max-w-2xl sm:max-w-3xl mx-auto py-4 min-h-[460px] flex flex-col justify-between select-none">
  <div class="absolute -top-10 -right-10 w-72 h-72 bg-ate-secondary/20 rounded-full blur-3xl -z-10"></div>
  <div class="absolute -bottom-10 -left-10 w-72 h-72 bg-ate-primary/20 rounded-full blur-3xl -z-10"></div>

  <!-- SVG Continuous Trajectory Line: Point 1 (Device) -> Point 2 (Establecimiento) -> Point 3 (SIN FILAS) -->
  <svg class="absolute inset-0 w-full h-full pointer-events-none z-10" viewBox="0 0 600 360">
    <defs>
      <linearGradient id="signal-grad-1" x1="0%" y1="100%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#14725b"></stop>
        <stop offset="100%" stop-color="#d4a373"></stop>
      </linearGradient>

      <linearGradient id="signal-grad-2" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#d4a373"></stop>
        <stop offset="100%" stop-color="#14725b"></stop>
      </linearGradient>

      <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="3" result="blur" />
        <feComposite in="SourceGraphic" in2="blur" operator="over" />
      </filter>
    </defs>

    <g id="trajectory-group" class="opacity-0 transition-opacity duration-500">
      <!-- Path 1 (Dashed Base): Device -> Bottom of Card 2 -->
      <path
        d="M 130 240 C 180 140, 230 40, 300 40"
        fill="none"
        stroke="#14725b"
        stroke-width="2.5"
        stroke-dasharray="6 6"
        class="opacity-30"
      ></path>

      <!-- Path 1 (Animated Gradient Arc) -->
      <path
        id="signal-arc-1"
        d="M 130 240 C 180 140, 230 40, 300 40"
        fill="none"
        stroke="url(#signal-grad-1)"
        stroke-width="3.5"
        stroke-linecap="round"
        stroke-dasharray="600"
        stroke-dashoffset="600"
        class="transition-all duration-700 ease-out"
      ></path>

      <!-- Path 2 (Dashed Base): Bottom of Card 2 -> Top of SIN FILAS -->
      <path
        d="M 300 40 C 370 40, 480 200, 530 320"
        fill="none"
        stroke="#d4a373"
        stroke-width="2.5"
        stroke-dasharray="6 6"
        class="opacity-30"
      ></path>

      <!-- Path 2 (Animated Gradient Arc) -->
      <path
        id="signal-arc-2"
        d="M 300 40 C 370 40, 480 200, 530 320"
        fill="none"
        stroke="url(#signal-grad-2)"
        stroke-width="3.5"
        stroke-linecap="round"
        stroke-dasharray="600"
        stroke-dashoffset="600"
        class="transition-all duration-700 ease-out"
      ></path>
    </g>

    <!-- Animated Moving Pulse Dots -->
    <circle id="signal-dot-1" cx="130" cy="240" r="5" fill="#14725b" filter="url(#glow)" class="opacity-0 transition-opacity duration-300"></circle>
    <circle id="signal-dot-2" cx="300" cy="40" r="5" fill="#d4a373" filter="url(#glow)" class="opacity-0 transition-opacity duration-300"></circle>
  </svg>

  <!-- POINT 2 (TOP CENTER): ESTABLECIMIENTO ALIADO -->
  <div class="w-full flex justify-center relative z-20 -translate-y-2">
    <div
      id="target-card"
      class="w-56 sm:w-64 h-[110px] bg-ate-surface border border-ate-text/10 rounded-2xl shadow-xl transition-all duration-700 ease-out transform translate-y-0 overflow-hidden flex flex-col justify-between"
    >
      <div id="store-awning" class="h-3 bg-gradient-to-r from-ate-primary via-ate-primary/80 to-ate-primary transition-all duration-700 flex items-center justify-around px-2">
        <div class="w-1.5 h-full bg-white/20"></div>
        <div class="w-1.5 h-full bg-white/20"></div>
        <div class="w-1.5 h-full bg-white/20"></div>
        <div class="w-1.5 h-full bg-white/20"></div>
      </div>

      <div class="p-2.5 flex-1 flex flex-col justify-between">
        <div id="target-header" class="flex items-center gap-2 pb-1.5 border-b border-ate-text/5 transition-opacity duration-500">
          <div id="target-icon-bg" class="w-6 h-6 rounded-lg bg-ate-primary/10 text-ate-primary flex items-center justify-center font-bold transition-all duration-700">
            <div id="icon-target-restaurante"><Icon name="lucide:store" class="w-3.5 h-3.5" /></div>
            <div id="icon-target-gimnasio" class="hidden"><Icon name="lucide:dumbbell" class="w-3.5 h-3.5" /></div>
            <div id="icon-target-clinica" class="hidden"><Icon name="lucide:stethoscope" class="w-3.5 h-3.5" /></div>
          </div>
          <div>
            <div id="target-title" class="font-heading font-extrabold text-[10.5px] text-ate-text uppercase tracking-wider transition-all duration-700">Restaurante</div>
          </div>
        </div>

        <div id="target-status" class="bg-ate-canvas p-1.5 rounded-lg border border-ate-text/5 text-center flex items-center justify-center min-h-[28px] overflow-hidden">
          <div id="status-idle" class="w-5 h-5 rounded-full border border-dashed border-ate-muted/40 flex items-center justify-center transition-opacity duration-300">
            <span class="w-1.5 h-1.5 rounded-full bg-ate-muted/40"></span>
          </div>
          <div id="status-active" class="hidden opacity-0 w-5 h-5 rounded-full bg-ate-primary/15 text-ate-primary flex items-center justify-center transition-opacity duration-300">
            <svg class="w-3.5 h-3.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="w-full flex justify-between items-end relative z-20 gap-4">
    <!-- POINT 1 (BOTTOM LEFT): DISPOSITIVO / APP -->
    <div class="flex flex-col items-center">
      <div
        id="device-frame"
        class="w-60 sm:w-72 bg-ate-surface border-4 border-ate-primary/70 rounded-[22px] p-3 shadow-2xl transition-all duration-700 ease-out transform translate-y-0 relative"
      >
        <div id="phone-notch" class="w-12 h-1.5 bg-ate-primary/40 rounded-full mx-auto mb-2 hidden transition-opacity duration-500"></div>

        <div class="bg-ate-canvas rounded-xl p-2.5 border border-ate-text/5 space-y-2.5">
          <div class="flex items-center justify-between pb-1 border-b border-ate-text/10">
            <div class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-ate-alert/70"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-ate-secondary/70"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-ate-primary/70"></span>
            </div>
            <div id="url-bar" class="text-[8.5px] font-mono text-ate-muted bg-white/80 px-1.5 py-0.5 rounded">app.ate.com</div>
          </div>

          <div id="source-item-box" class="p-2 rounded-lg bg-white flex items-center justify-between border border-ate-text/5 shadow-sm transition-opacity duration-500">
            <div class="flex items-center gap-2">
              <div class="w-6 h-6 rounded-lg bg-ate-primary/10 text-ate-primary flex items-center justify-center font-bold">
                <div id="icon-source-restaurante"><Icon name="lucide:utensils" class="w-3 h-3" /></div>
                <div id="icon-source-gimnasio" class="hidden"><Icon name="lucide:dumbbell" class="w-3 h-3" /></div>
                <div id="icon-source-clinica" class="hidden"><Icon name="lucide:stethoscope" class="w-3 h-3" /></div>
              </div>
              <div>
                <div id="source-item-name" class="font-semibold text-[11px] text-ate-text">Almuerzo Ejecutivo</div>
                <div class="text-[8px] text-ate-muted">Menú del Día</div>
              </div>
            </div>
            <span id="source-item-price" class="font-heading font-bold text-[11px] text-ate-primary">$3.50</span>
          </div>

          <button
            id="simulate-btn"
            class="w-full py-1.5 rounded-xl bg-ate-primary text-white font-bold text-[11px] shadow-ate-sm hover:bg-ate-primary/95 active:scale-98 transition-all cursor-pointer flex items-center justify-center gap-1.5"
          >
            <span id="btn-text">Pedir Reserva</span>
            <Icon name="lucide:arrow-right" class="w-3 h-3" />
          </button>
        </div>
      </div>

      <div id="monitor-neck" class="w-8 h-3 bg-gradient-to-b from-ate-primary/60 to-ate-primary/80 mx-auto -mt-0.5 shadow-inner rounded-b-sm transition-all duration-500"></div>
      <div id="monitor-base" class="w-28 h-2 bg-gradient-to-r from-ate-primary/60 via-ate-primary/80 to-ate-primary/60 mx-auto rounded-full shadow-md border-t border-white/20 transition-all duration-500"></div>
    </div>

    <!-- POINT 3 (BOTTOM RIGHT): UNDRAW SVG FELIZ -->
    <div
      id="user-card"
      class="relative w-36 h-36 flex justify-center items-end transition-all duration-700 ease-out transform translate-y-0 mr-2 sm:mr-6"
    >
      <img id="happy-svg" src="/happy.svg" alt="Happy Person" class="w-full h-full object-contain filter drop-shadow-xl transition-transform duration-500 origin-bottom" />
    </div>
  </div>
</div>

<script>
  const deviceFrame = document.getElementById('device-frame');
  const phoneNotch = document.getElementById('phone-notch');
  const monitorNeck = document.getElementById('monitor-neck');
  const monitorBase = document.getElementById('monitor-base');
  const btnText = document.getElementById('btn-text');
  
  const targetCard = document.getElementById('target-card');
  const targetHeader = document.getElementById('target-header');
  const storeAwning = document.getElementById('store-awning');
  const targetTitle = document.getElementById('target-title');
  const targetIconBg = document.getElementById('target-icon-bg');
  const simulateBtn = document.getElementById('simulate-btn');

  const trajectoryGroup = document.getElementById('trajectory-group');
  const userCard = document.getElementById('user-card');

  const signalArc1 = document.getElementById('signal-arc-1');
  const signalArc2 = document.getElementById('signal-arc-2');
  const signalDot1 = document.getElementById('signal-dot-1');
  const signalDot2 = document.getElementById('signal-dot-2');

  const sourceItemBox = document.getElementById('source-item-box');
  const sourceItemName = document.getElementById('source-item-name');
  const sourceItemPrice = document.getElementById('source-item-price');

  const statusIdle = document.getElementById('status-idle');
  const statusActive = document.getElementById('status-active');

  const demoItems = [
    { name: 'Almuerzo Ejecutivo', price: '$3.50', venue: 'Restaurante', iconId: 'restaurante', awningClass: 'from-ate-primary via-ate-primary/80 to-ate-primary', bgClass: 'bg-ate-primary/10 text-ate-primary' },
    { name: 'Pase de Gimnasio', price: '$4.20', venue: 'Gimnasio', iconId: 'gimnasio', awningClass: 'from-ate-secondary via-ate-secondary/80 to-ate-secondary', bgClass: 'bg-ate-secondary/10 text-ate-secondary' },
    { name: 'Consulta Médica', price: '$5.00', venue: 'Clínica', iconId: 'clinica', awningClass: 'from-ate-alert via-ate-alert/80 to-ate-alert', bgClass: 'bg-ate-alert/10 text-ate-alert' },
  ];

  let itemIdx = 0;
  let isRunning = false;
  let isMobileMode = false;

  function toggleDeviceMode() {
    if (!deviceFrame) return;

    deviceFrame.classList.add('opacity-0', 'scale-95');

    setTimeout(() => {
      isMobileMode = !isMobileMode;

      if (isMobileMode) {
        deviceFrame.className = 'w-52 sm:w-56 bg-ate-surface border-4 border-ate-primary/70 rounded-[28px] p-3 shadow-2xl transition-all duration-700 ease-out transform translate-y-0 relative';
        if (phoneNotch) phoneNotch.classList.remove('hidden');
        if (monitorNeck) monitorNeck.style.display = 'none';
        if (monitorBase) monitorBase.style.display = 'none';
        if (btnText) btnText.textContent = 'Pedir en App Móvil';
      } else {
        deviceFrame.className = 'w-60 sm:w-72 bg-ate-surface border-4 border-ate-primary/70 rounded-[22px] p-3 shadow-2xl transition-all duration-700 ease-out transform translate-y-0 relative';
        if (phoneNotch) phoneNotch.classList.add('hidden');
        if (monitorNeck) monitorNeck.style.display = 'block';
        if (monitorBase) monitorBase.style.display = 'block';
        if (btnText) btnText.textContent = 'Pedir Reserva';
      }

      deviceFrame.classList.remove('opacity-0', 'scale-95');
    }, 400);
  }

  function activateCheckmark() {
    if (targetCard) {
      targetCard.classList.add('-translate-y-1', 'shadow-2xl');
    }
    if (statusIdle && statusActive) {
      statusIdle.classList.add('hidden');
      statusActive.classList.remove('hidden');
      requestAnimationFrame(() => {
        statusActive.classList.remove('opacity-0');
        statusActive.classList.add('opacity-100');
      });
    }
  }

  function resetCheckmark() {
    if (targetCard) {
      targetCard.classList.remove('-translate-y-1', 'shadow-2xl');
    }
    if (statusIdle && statusActive) {
      statusActive.classList.remove('opacity-100');
      statusActive.classList.add('opacity-0');
      setTimeout(() => {
        statusActive.classList.add('hidden');
        statusIdle.classList.remove('hidden');
      }, 300);
    }
  }

  function activateUserExperience() {
    if (userCard) {
      userCard.classList.add('-translate-y-3');
    }
    const happySvg = document.getElementById('happy-svg');
    if (happySvg) happySvg.classList.add('scale-105', '-rotate-3');
  }

  function resetUserExperience() {
    if (userCard) {
      userCard.classList.remove('-translate-y-3');
    }
    const happySvg = document.getElementById('happy-svg');
    if (happySvg) happySvg.classList.remove('scale-105', '-rotate-3');
  }

  function animateDot(arcEl: HTMLElement | null, dotEl: HTMLElement | null, duration: number, onArrival: () => void) {
    if (!arcEl || !dotEl) return;
    const svgArc = arcEl as unknown as SVGPathElement;
    const totalLength = svgArc.getTotalLength();
    let startTime: number | null = null;

    dotEl.classList.remove('opacity-0');
    dotEl.classList.add('opacity-100');

    function step(timestamp: number) {
      if (!startTime) startTime = timestamp;
      const progress = Math.min((timestamp - startTime) / duration, 1);
      const easeProgress = 1 - Math.pow(1 - progress, 2.2);
      const point = svgArc.getPointAtLength(easeProgress * totalLength);

      dotEl?.setAttribute('cx', point.x.toString());
      dotEl?.setAttribute('cy', point.y.toString());

      if (progress < 1) {
        requestAnimationFrame(step);
      } else {
        onArrival();
        setTimeout(() => {
          dotEl?.classList.remove('opacity-100');
          dotEl?.classList.add('opacity-0');
        }, 80);
      }
    }

    requestAnimationFrame(step);
  }

  function runSmoothStoryline() {
    if (isRunning || !deviceFrame || !targetCard || !signalArc1 || !signalArc2 || !signalDot1 || !signalDot2) return;
    isRunning = true;

    if (trajectoryGroup) {
      trajectoryGroup.classList.remove('opacity-0');
      trajectoryGroup.classList.add('opacity-100');
    }

    const currentItem = demoItems[itemIdx];
    itemIdx = (itemIdx + 1) % demoItems.length;

    if (targetHeader) targetHeader.classList.add('opacity-30');
    if (sourceItemBox) sourceItemBox.classList.add('opacity-30');

    setTimeout(() => {
      if (storeAwning) storeAwning.className = `h-3 bg-gradient-to-r ${currentItem.awningClass} transition-all duration-700 flex items-center justify-around px-2`;
      if (targetTitle) targetTitle.textContent = currentItem.venue;
      if (targetIconBg) targetIconBg.className = `w-6 h-6 rounded-lg ${currentItem.bgClass} flex items-center justify-center font-bold transition-all duration-700`;

      ['restaurante', 'gimnasio', 'clinica'].forEach(id => {
        const el = document.getElementById('icon-target-' + id);
        if (el) el.classList.add('hidden');
      });
      const activeTargetIcon = document.getElementById('icon-target-' + currentItem.iconId);
      if (activeTargetIcon) activeTargetIcon.classList.remove('hidden');

      if (targetHeader) targetHeader.classList.remove('opacity-30');
      if (sourceItemBox) sourceItemBox.classList.remove('opacity-30');
    }, 250);

    deviceFrame.classList.add('-translate-y-1.5', 'shadow-2xl');

    setTimeout(() => {
      deviceFrame.classList.remove('-translate-y-1.5');

      if (signalArc1) signalArc1.style.strokeDashoffset = '0';

      animateDot(signalArc1, signalDot1, 750, () => {
        activateCheckmark();

        setTimeout(() => {
          if (signalArc2) signalArc2.style.strokeDashoffset = '0';

          animateDot(signalArc2, signalDot2, 750, () => {
            activateUserExperience();

            setTimeout(() => {
              resetCheckmark();
              resetUserExperience();

              if (trajectoryGroup) {
                trajectoryGroup.classList.remove('opacity-100');
                trajectoryGroup.classList.add('opacity-0');
              }

              setTimeout(() => {
                if (signalArc1) signalArc1.style.transition = 'none';
                if (signalArc2) signalArc2.style.transition = 'none';
                if (signalArc1) signalArc1.style.strokeDashoffset = '600';
                if (signalArc2) signalArc2.style.strokeDashoffset = '600';

                setTimeout(() => {
                  if (signalArc1) signalArc1.style.transition = '';
                  if (signalArc2) signalArc2.style.transition = '';
                }, 50);
              }, 500);

              if (sourceItemBox) sourceItemBox.classList.add('opacity-30');
              setTimeout(() => {
                if (sourceItemName) sourceItemName.textContent = demoItems[itemIdx].name;
                if (sourceItemPrice) sourceItemPrice.textContent = demoItems[itemIdx].price;
                
                ['restaurante', 'gimnasio', 'clinica'].forEach(id => {
                  const el = document.getElementById('icon-source-' + id);
                  if (el) el.classList.add('hidden');
                });
                const activeSourceIcon = document.getElementById('icon-source-' + demoItems[itemIdx].iconId);
                if (activeSourceIcon) activeSourceIcon.classList.remove('hidden');

                if (sourceItemBox) sourceItemBox.classList.remove('opacity-30');
              }, 200);

              isRunning = false;
            }, 2200);
          });

        }, 200);
      });

    }, 400);
  }

  if (simulateBtn) {
    simulateBtn.addEventListener('click', runSmoothStoryline);
  }

  setInterval(runSmoothStoryline, 6500);
  setInterval(toggleDeviceMode, 16000);
</script>
